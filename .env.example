# MetricChronicle Environment Configuration Example
# Copy this file to .env and insert your real API credentials.

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Hindsight Vectorize API Credentials (https://hindsight.vectorize.io/)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=metricchronicle
